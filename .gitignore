# macOS
.DS_Store

# Swift / Xcode
.build/
.swiftpm/
.xcbuild/
# Package.resolved IS tracked. mako ships as an executable, and every dependency is
# declared with `from:`, so an untracked lockfile means Homebrew builds whatever is
# latest at install time rather than what was tested.
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Python
**/__pycache__/
**/*.py[oc]
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
build/
dist/
wheels/
*.egg-info/

# Model outputs / artifacts
outputs/
*.wav
*.m4a
# ...except the bundled `--hq` voice, which is a source asset rather than an output.
# Fish clones in context, so there is no per-voice model to build: the clip and its
# transcript ship inside the binary and a clone cannot happen without them.
!Sources/TTSHarnessCore/Resources/*.wav
models/
scratch/

# Editor
**/.vscode/*
.idea/
*.sw?

# Local clone of the speech-swift dependency, kept beside the package for reading
# its sources. It is its own git repo, so it can never be committed here anyway.
speech-swift/

# Claude related
**/.env
src.md
**/CLAUDE.md
.clemp-lock.yaml
**/.claude
**/AGENTS.md
**/.agent/
REPOMAP.md
CODEGUIDE.md
**/.cursor
.mcp.json
